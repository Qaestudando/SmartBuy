icy",match:"wyszukuje wartości w odniesieniu lub tablicy",rank:"zwraca rangę liczby na liście liczb",frequency:"zwraca rozkład częstotliwości jako tablicę pionową",text:"formatuje liczbę i konwertuje ją na tekst",left:"zwraca znaki od lewej strony wartości tekstowej",right:"zwraca znaki od prawej strony wartości tekstowej",round:"zaokrągla liczbę do określonej liczby cyfr",index:"wybiera wartość z odniesienia lub tablicy za pomocą indeksu",countif:"zlicza komórki w zakresie spełniające podane kryteria",countifs:"zlicza komórki w zakresie spełniające wiele kryteriów",mid:"zwraca określoną liczbę znaków z ciągu tekstowego od pozycji początkowej",len:"zwraca liczbę znaków w ciągu tekstowym",power:"zwraca wynik podniesienia liczby do potęgi",ceiling:"zaokrągla liczbę w górę do najbliższej liczby całkowitej",floor:"zaokrągla liczbę w dół do zera",substitute:"zastępuje stary tekst nowym tekstem w ciągu",replace:"zastępuje znaki w tekście",search:"znajduje tekst w innym ciągu bez rozróżniania wielkości liter",find:"znajduje tekst w innym ciągu z rozróżnianiem wielkości liter",isnumber:"zwraca TRUE, jeśli wartość jest liczbą",istext:"zwraca TRUE, jeśli wartość jest tekstem",isblank:"zwraca TRUE, jeśli wartość jest pusta",upper:"konwertuje tekst na wielkie litery",lower:"konwertuje tekst na małe litery",product:"mnoży argumenty",sumproduct:"zwraca sumę iloczynów odpowiadających elementów tablicy",subtotal:"zwraca sumę częściową w liście lub bazie danych",counta:"zlicza wartości w liście argumentów",averageif:"zwraca średnią arytmetyczną komórek spełniających dane kryterium",averageifs:"zwraca średnią arytmetyczną komórek spełniających wiele kryteriów",trim:"usuwa spacje z tekstu",sign:"zwraca znak liczby",yield:"zwraca zysk papieru wartościowego wypłacającego odsetki okresowe",abs:"zwraca wartość bezwzględną liczby",sin:"zwraca sinus zadanego kąta",cos:"zwraca cosinus liczby",tan:"zwraca tangens liczby",proper:"Konwertuje tekst na format tytułowy, zmieniając pierwszą literę 